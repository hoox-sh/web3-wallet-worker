# Web3 Wallet Worker Environment Variables (local development)
# Copy to .dev.vars and replace with actual values from `hoox setup` output.
# .dev.vars is gitignored — never commit secrets.

# Internal auth key for service-to-service authentication
INTERNAL_KEY_BINDING=your_internal_key_binding_here

# JSON-encoded wallet private key (for production, use wrangler secret put)
# WALLET_PK_SECRET={"PRIVATE_KEY": "0xabcdef123456...7890"}

# JSON-encoded wallet mnemonic phrase (for production, use wrangler secret put)
# WALLET_MNEMONIC_SECRET={"MNEMONIC_PHRASE": "word1 word2 ... word12"}
